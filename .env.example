# Postgres (docker compose)
# In production use a password without URL-special characters (@ : / ? #), it goes into DATABASE_URL
POSTGRES_USER=smart_calendar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smart_calendar
POSTGRES_PORT=5432

# Prisma and NestJS
DATABASE_URL="postgresql://smart_calendar:change_me@localhost:5432/smart_calendar?schema=public"

# Google client ID from Google Cloud
GOOGLE_CLIENT_ID=

# Production (docker-compose.prod.yaml): the site domain for Caddy and HTTPS, e.g. calendar.example.com
DOMAIN=localhost
