generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CalendarRole {
  OWNER
  EDITOR
  VIEWER
}

enum TagColor {
  GRAY
  RED
  ORANGE
  YELLOW
  GREEN
  TEAL
  BLUE
  VIOLET
  PINK
}

model User {
  id             String           @id @default(uuid())
  googleId       String           @unique
  email          String           @unique
  name           String
  avatarUrl      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  memberships    CalendarMember[]
  sessions       Session[]
  invitesCreated CalendarInvite[] @relation("InviteCreatedBy")
  invitesUsed    CalendarInvite[] @relation("InviteUsedBy")
}

model Calendar {
  id            String           @id @default(uuid())
  name          String           @default("")
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  members       CalendarMember[]
  events        Event[]
  tagCategories TagCategory[]
  invites       CalendarInvite[]
}

model CalendarInvite {
  id          String       @id @default(uuid())
  calendarId  String
  tokenHash   String       @unique
  role        CalendarRole
  createdById String
  expiresAt   DateTime     @db.Timestamptz(3)
  usedAt      DateTime?    @db.Timestamptz(3)
  usedById    String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  calendar    Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy      User?        @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([calendarId])
}

model CalendarMember {
  calendarId String
  userId     String
  role       CalendarRole @default(EDITOR)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  calendar   Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([calendarId, userId])
  @@index([userId])
}

model Event {
  id             String           @id @default(uuid())
  calendarId     String
  title          String           @default("")
  description    String?
  icon           String?
  startAt        DateTime         @db.Timestamptz(3)
  endAt          DateTime         @db.Timestamptz(3)
  allDay         Boolean          @default(true)
  completedAt    DateTime?        @db.Timestamptz(3)
  archivedAt     DateTime?        @db.Timestamptz(3)
  recurrenceRule String?
  timeZone       String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  calendar       Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  tags           EventTag[]
  exceptions     EventException[]

  @@index([calendarId, startAt])
  @@index([calendarId, archivedAt])
}

model EventException {
  id            String   @id @default(uuid())
  eventId       String
  originalStart DateTime @db.Timestamptz(3)
  cancelled     Boolean  @default(false)
  overrides     Json?
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
}

model TagCategory {
  id         String   @id @default(uuid())
  calendarId String
  name       String
  multiple   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  tags       Tag[]

  @@index([calendarId])
}

model Tag {
  id         String      @id @default(uuid())
  categoryId String
  name       String
  color      TagColor    @default(GRAY)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  events     EventTag[]

  @@index([categoryId])
}

model EventTag {
  eventId String
  tagId   String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  userAgent  String?
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
