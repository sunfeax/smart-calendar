generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CalendarRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id          String           @id @default(uuid())
  googleId    String           @unique
  email       String           @unique
  name        String
  avatarUrl   String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  memberships CalendarMember[]
  sessions     Session[]
}

model Calendar {
  id        String           @id @default(uuid())
  name      String           @default("")
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  members   CalendarMember[]
  events    Event[]
}

model CalendarMember {
  calendarId String
  userId     String
  role       CalendarRole @default(EDITOR)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  calendar   Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([calendarId, userId])
  @@index([userId])
}

model Event {
  id          String    @id @default(uuid())
  calendarId  String
  title       String
  description String?
  startAt     DateTime  @db.Timestamptz(3)
  endAt       DateTime  @db.Timestamptz(3)
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  calendar    Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId, startAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  userAgent  String?
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
