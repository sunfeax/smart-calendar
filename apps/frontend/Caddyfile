{$DOMAIN} {
	encode zstd gzip

	request_body /api/* {
		max_size 1MB
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/ https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}

	@static {
		path *.js *.css *.woff2
		not path /ngsw-worker.js /safety-worker.js
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	@dynamic {
		not {
			path *.js *.css *.woff2
			not path /ngsw-worker.js /safety-worker.js
		}
	}
	header @dynamic Cache-Control "no-cache"
}
